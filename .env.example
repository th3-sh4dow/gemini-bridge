# Panda BYOK bridge
#
# The app sends the user's own provider key on every request; this server
# forwards it to that provider and returns the reply in the shape the app
# expects. No subscription, no server-side key, no paywall.

PORT=3000
NODE_ENV=production

# Upstream base URLs. Only override for testing or a self-hosted gateway.
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
ANTHROPIC_BASE_URL=https://api.anthropic.com
OPENAI_BASE_URL=https://api.openai.com/v1
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# OpenRouter attribution headers (optional)
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=Panda BYOK

# Request timeouts (ms)
BRIDGE_TIMEOUT_MS=60000
BRIDGE_PROBE_TIMEOUT_MS=12000

# Verbose request/response logging (default: off)
BRIDGE_LOG=_minimal_
