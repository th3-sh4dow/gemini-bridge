# Gemini Bridge Server
# Panda app -> this bridge -> Google Gemini API
# The app sends its own Gemini key; this server forwards it.

PORT=3000
NODE_ENV=production

# Optional: base URL of the real Gemini API if you ever need to override
GEMINI_BASE_URL=https://generativelanguage.googleapis.com

# Enable verbose request/response logging (default: false)
BRIDGE_LOG=_minimal_
